{
  "name": "daily-report",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install",
    "prepare": "husky",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "api:types": "tsx scripts/generate-api-types.ts",
    "api:generate": "pnpm run openapi:generate && pnpm run api:types",
    "perf:k6": "k6 run performance-tests/k6/comprehensive-test.js",
    "perf:artillery": "artillery run performance-tests/artillery/",
    "perf:db-seed": "tsx performance-tests/utils/seed-large-dataset.ts",
    "perf:db-cleanup": "tsx performance-tests/utils/cleanup-test-data.ts",
    "perf:all": "pnpm run perf:db-seed && pnpm run perf:k6 && pnpm run perf:db-cleanup",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.4",
    "artillery": "^2.0.24",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "next": "^15.5.2",
    "openapi-fetch": "^0.14.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.15.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "prisma": "^6.15.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
