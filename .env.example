# データベース（Neon / PostgreSQL）
# アプリ実行用: プール接続（pgbouncer）
DATABASE_URL="postgresql://user:password@localhost:5432/daily_report?schema=public"
# マイグレーション用: 直接接続
DIRECT_URL="postgresql://user:password@localhost:5432/daily_report?schema=public"

# 認証（JWT）
# 十分に長いランダム文字列を設定すること（例: openssl rand -base64 48）
JWT_SECRET=""
# 有効期限（jsonwebtoken の expiresIn 形式）
JWT_EXPIRES_IN="24h"

# 開発用: 認証実装（#7, #8）までの間、ログイン状態を仮定する（member | manager）。本番では無効
# DEV_STUB_USER="manager"
