# データベース
# ローカル: `docker compose up -d` で起動する PostgreSQL（ポート 5433）
# 本番/Preview: Neon（Vercel Marketplace 経由で自動設定される）
#   DATABASE_URL = プール接続（pgbouncer）、DIRECT_URL = 直接接続
DATABASE_URL="postgresql://daily_report:daily_report@localhost:5433/daily_report?schema=public"
DIRECT_URL="postgresql://daily_report:daily_report@localhost:5433/daily_report?schema=public"

# 自動テスト（pnpm test:db）用のデータベース。開発用 DB とは必ず分けること（テストごとにデータを削除する）
TEST_DATABASE_URL="postgresql://daily_report:daily_report@localhost:5433/daily_report_test?schema=public"

# 認証（JWT）
# 32 文字以上のランダム文字列（例: openssl rand -base64 48）。未設定・短い場合は起動時にエラーになる
JWT_SECRET=""
# 有効期限（jsonwebtoken の expiresIn 形式）
JWT_EXPIRES_IN="24h"

# シード（pnpm db:seed）は全データを削除して入れ直す。接続先がローカル以外（Neon など）の場合は、
# 意図している場合のみ true を付けて実行する。本番（NODE_ENV / VERCEL_ENV が production）では常に拒否される
# SEED_ALLOW_REMOTE="true"
